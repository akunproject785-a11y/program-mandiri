# ============================================================
# Program Qur'an Mandiri — Contoh environment variables
# Salin file ini menjadi .env lalu isi dengan nilai asli.
# JANGAN pernah commit .env ke git!
# ============================================================

# --- Supabase (Dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — HANYA di server (Route Handlers). Jangan pernah
# di-awali NEXT_PUBLIC_ dan jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- PostgreSQL Supabase (Project Settings -> Database) ---
# Runtime Prisma: gunakan connection pooler (port 6543, transaction mode).
# Password dengan karakter khusus harus di-encode (contoh: # menjadi %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password-encoded>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Koneksi langsung untuk prisma db push / migrate (session pooler port 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password-encoded>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Opsional: script bantu ---
# Password ter-encode untuk scripts/probe-pooler.mjs & scripts/find-region.ts
SUPABASE_DB_PASSWORD_ENCODED=
